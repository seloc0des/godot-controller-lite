; Controller — Lite (demo project). Autoload declared manually; plugin stays off here.

config_version=5

[application]

config/name="Controller (Lite)"
run/main_scene="res://demo/controller_demo.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

ControllersLite="*res://addons/controller_lite/controllers_bus_lite.gd"

[display]

window/size/viewport_width=900
window/size/viewport_height=600

[editor_plugins]

enabled=PackedStringArray("res://addons/controller_lite/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
